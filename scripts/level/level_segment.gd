class_name LevelSegment
extends Resource
## Участок уровня с замком камеры: когда центр камеры доезжает до lock_x,
## камера встаёт, героиня заперта в экране и по очереди выходят волны.
## После последней волны замок снимается («GO →»).

## x центра камеры в замке, px (экран — lock_x ± 640).
@export var lock_x: float = 1500.0
## Волны по порядку.
@export var waves: Array[WaveData] = []
## Арена босса: замок без волн, который не снимается (пока — заглушка с надписью).
@export var is_boss_arena: bool = false
## Надпись по центру экрана при входе в замок (для арены босса).
@export var banner_text: String = ""
