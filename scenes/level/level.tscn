[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/level/level.gd" id="1_level"]
[ext_resource type="Resource" path="res://data/levels/ocean_drive.tres" id="2_data"]
[ext_resource type="PackedScene" path="res://scenes/props/breakable.tscn" id="3_breakable"]
[ext_resource type="Script" path="res://scripts/level/street.gd" id="4_street"]
[ext_resource type="PackedScene" path="res://scenes/player/player.tscn" id="5_player"]
[ext_resource type="Script" path="res://scripts/level/beat_camera.gd" id="6_camera"]
[ext_resource type="Script" path="res://scripts/ai/attack_director.gd" id="7_director"]
[ext_resource type="Script" path="res://scripts/level/enemy_spawner.gd" id="8_spawner"]
[ext_resource type="PackedScene" path="res://scenes/enemies/enemy.tscn" id="9_enemy"]
[ext_resource type="Script" path="res://scripts/actors/enemy_data.gd" id="10_enemy_data"]
[ext_resource type="Resource" path="res://data/enemies/patrol.tres" id="11_patrol"]
[ext_resource type="Resource" path="res://data/enemies/bike.tres" id="12_bike"]
[ext_resource type="Resource" path="res://data/enemies/riot.tres" id="13_riot"]
[ext_resource type="Script" path="res://scripts/level/level_director.gd" id="14_level_director"]
[ext_resource type="Script" path="res://scripts/level/street_debug_overlay.gd" id="15_overlay"]
[ext_resource type="Script" path="res://scripts/ui/level_hud.gd" id="16_hud"]

[node name="Level" type="Node2D"]
script = ExtResource("1_level")
level_data = ExtResource("2_data")
breakable_scene = ExtResource("3_breakable")

[node name="Background" type="Node2D" parent="."]

[node name="Street" type="Node2D" parent="."]
script = ExtResource("4_street")
street_width = 8000.0
draw_background = false

[node name="World" type="Node2D" parent="Street"]
y_sort_enabled = true

[node name="Player" parent="Street/World" instance=ExtResource("5_player")]
position = Vector2(300, 560)

[node name="Foreground" type="Node2D" parent="."]

[node name="Camera" type="Camera2D" parent="." node_paths=PackedStringArray("target", "street")]
position = Vector2(640, 360)
script = ExtResource("6_camera")
target = NodePath("../Street/World/Player")
street = NodePath("../Street")

[node name="AttackDirector" type="Node" parent="."]
script = ExtResource("7_director")

[node name="EnemySpawner" type="Node" parent="." node_paths=PackedStringArray("street")]
script = ExtResource("8_spawner")
street = NodePath("../Street")
enemy_scene = ExtResource("9_enemy")
enemy_types = Array[ExtResource("10_enemy_data")]([ExtResource("11_patrol"), ExtResource("12_bike"), ExtResource("13_riot")])
autoplay_spawning = false

[node name="LevelDirector" type="Node" parent="." node_paths=PackedStringArray("camera", "spawner", "hud")]
script = ExtResource("14_level_director")
level_data = ExtResource("2_data")
camera = NodePath("../Camera")
spawner = NodePath("../EnemySpawner")
hud = NodePath("../Hud")

[node name="DebugOverlay" type="Node2D" parent="." node_paths=PackedStringArray("street")]
script = ExtResource("15_overlay")
street = NodePath("../Street")

[node name="Hud" type="CanvasLayer" parent="."]
script = ExtResource("16_hud")
